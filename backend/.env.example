############################################################
# Stream Watch Backend Environment Configuration (.env.example)
#
# IMPORTANT: Do NOT commit real secrets to version control.
# Copy this file to .env and replace the placeholder values.
############################################################

########################
# Core App Settings
########################
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

########################
# Database
########################
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

########################
# OTP / Email Delivery
########################
# Option A: Gmail / Provider with predefined service name
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password # App Password (NOT your normal login password)

# Option B: Generic SMTP (preferred for production)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true if using port 465 with SSL
# EMAIL_USER=your_smtp_username
# EMAIL_PASS=your_smtp_password_or_app_password

# Optional custom from address (defaults to EMAIL_USER if not set)
# EMAIL_FROM="Stream Watch <no-reply@yourdomain.com>"

########################
# External Service Endpoints
########################
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
MONGODB_EXPORTER_URL=http://localhost:9216

########################
# AI / External APIs
########################
GEMINI_API_KEY=your_gemini_api_key_here

############################################################
# Guidance:
# 1. For Gmail: enable 2FA, create an App Password, use it as EMAIL_PASS.
# 2. For other providers: set SMTP_HOST/PORT/SECURE and EMAIL_USER/PASS.
# 3. Never leave EMAIL_USER or EMAIL_PASS empty if you expect real emails.
# 4. In development without creds, OTP will only print in the server logs.
# 5. Generate a strong JWT_SECRET (e.g. 64+ chars).
############################################################
